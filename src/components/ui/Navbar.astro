---
// Navbar.astro
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-slate-950/80 border-b border-slate-800/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-600 p-[1px] shadow-[0_0_15px_rgba(6,182,212,0.4)] transition-transform group-hover:scale-105">
        <div class="w-full h-full bg-slate-950 rounded-[11px] flex items-center justify-center">
          <svg class="w-5 h-5 text-cyan-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3.6 9h16.8M3.6 15h16.8" />
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18" />
          </svg>
        </div>
      </div>
      <div>
        <span class="font-extrabold text-white text-base tracking-tight group-hover:text-cyan-300 transition-colors">
          SwiftFlow <span class="text-cyan-400">3D</span>
        </span>
        <span class="hidden sm:inline-block ml-2 px-1.5 py-0.5 rounded text-[10px] font-mono bg-cyan-950/80 text-cyan-300 border border-cyan-800/60 font-semibold">
          ISO 20022
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-mono text-slate-400">
      <a href="#globe-section" class="hover:text-cyan-300 transition-colors">3D Globe Mesh</a>
      <a href="#story-section" class="hover:text-cyan-300 transition-colors">MT vs MX Migration</a>
      <a href="#converter-section" class="hover:text-cyan-300 transition-colors">Live AI Studio</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
        <span>GitHub</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>

    <!-- Right status badge & CTA -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-[11px] font-mono text-slate-300">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Astro Islands Active</span>
      </div>

      <a
        href="#converter-section"
        class="glass-button px-4 py-2 rounded-xl text-xs font-bold text-cyan-300 hover:text-white transition-all shadow-[0_0_15px_rgba(6,182,212,0.2)]"
      >
        Try Converter
      </a>
    </div>
  </div>
</header>
